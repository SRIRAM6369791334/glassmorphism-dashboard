{
  "name": "glass-auth-api",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "dev": "node --watch -r ts-node/register src/main.ts",
    "dev:worker": "node --watch -r ts-node/register src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.js",
    "lint": "eslint src test prisma/seed.ts",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "test": "npm run test:unit",
    "test:unit": "tsc -p tsconfig.test.json && node --test artifacts/test-build/test/unit/*.test.js",
    "test:integration": "tsc -p tsconfig.test.json && node scripts/run-integration.cjs",
    "check": "npm run lint && npm run build && npm run test:unit",
    "mail:dev": "node scripts/mail-dev.cjs",
    "db:migrate:test": "node scripts/migrate-test.cjs"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@prisma/client": "6.19.3",
    "argon2": "0.45.1",
    "bullmq": "6.3.11",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "10.0.16",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/testing": "12.1.2",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/smtp-server": "3.5.13",
    "@types/supertest": "7.2.1",
    "eslint": "10.12.0",
    "prisma": "6.19.3",
    "smtp-server": "3.19.18",
    "supertest": "7.3.1",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
