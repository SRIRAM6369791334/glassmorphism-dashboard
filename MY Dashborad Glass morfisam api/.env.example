# Use separate dev and test databases. Production uses a secret manager.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=mysql://glass_auth:replace-database-password@127.0.0.1:3307/glass_auth?connection_limit=10&pool_timeout=10
TEST_DATABASE_URL=mysql://glass_auth:replace-database-password@127.0.0.1:3307/glass_auth_test?connection_limit=10&pool_timeout=10
DB_POOL_SIZE=10
DB_POOL_TIMEOUT_SECONDS=10
REDIS_URL=redis://127.0.0.1:6380/0
# Four independent random secrets, each >=32 characters. No default secrets.
JWT_ACCESS_SECRET=replace-with-independent-random-secret
TOKEN_HASH_SECRET=replace-with-independent-random-secret
OTP_SECRET=replace-with-independent-random-secret
RECEIPT_SECRET=replace-with-independent-random-secret
JWT_ISSUER=glass-auth-api
JWT_AUDIENCE=glass-auth-web
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
RESET_TOKEN_TTL_SECONDS=600
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_COOLDOWN_SECONDS=60
PASSWORD_MIN_LENGTH=12
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Comma-separated trusted proxy IPs/subnets, blank for direct traffic. Never use blanket trust.
TRUST_PROXY=
RATE_WINDOW_SECONDS=60
RATE_NORMAL=120
RATE_LOGIN=10
RATE_OTP_SEND=5
RATE_OTP_VERIFY=10
RATE_FORGOT=5
IDEMPOTENCY_TTL_SECONDS=86400
EMAIL_PROVIDER=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Glass Auth <no-reply@localhost>
# Optional provider with delivery idempotency; never needed for local tests.
RESEND_API_KEY=
EMAIL_TIMEOUT_MS=10000
QUEUE_NAME=glass-auth-email
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=1000
WORKER_CONCURRENCY=5
OUTBOX_POLL_MS=1000
OUTBOX_LEASE_MS=120000
OUTBOX_BATCH_SIZE=50
# Required >=32 random characters in production; protects the internal scrape endpoint.
METRICS_TOKEN=
