generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  LOCKED
  DELETED
}

enum OtpPurpose {
  SIGNUP
  FORGOT_PASSWORD
  CHANGE_EMAIL
  LOGIN_VERIFICATION
}

enum OutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model User {
  id              BigInt               @id @default(autoincrement()) @db.UnsignedBigInt
  publicId        String               @unique @map("public_id") @db.Char(36)
  email           String?              @unique @db.VarChar(254)
  phone           String?              @unique @db.VarChar(20)
  passwordHash    String               @map("password_hash") @db.VarChar(255)
  status          UserStatus           @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?            @map("email_verified_at") @db.DateTime(6)
  phoneVerifiedAt DateTime?            @map("phone_verified_at") @db.DateTime(6)
  lastLoginAt     DateTime?            @map("last_login_at") @db.DateTime(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt       DateTime?            @map("deleted_at") @db.DateTime(6)
  profile         UserProfile?
  roles           UserRole[]
  emailOtps       EmailOtp[]
  resetTokens     PasswordResetToken[]
  refreshTokens   RefreshToken[]
  sessions        UserSession[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@index([status])
  @@map("users")
}

model UserProfile {
  id              BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId          BigInt    @unique @map("user_id") @db.UnsignedBigInt
  firstName       String?   @map("first_name") @db.VarChar(100)
  lastName        String?   @map("last_name") @db.VarChar(100)
  displayName     String?   @map("display_name") @db.VarChar(200)
  profileImageUrl String?   @map("profile_image_url") @db.VarChar(2048)
  dateOfBirth     DateTime? @map("date_of_birth") @db.Date
  gender          String?   @db.VarChar(50)
  createdAt       DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  deletedAt       DateTime? @map("deleted_at") @db.DateTime(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_profiles")
}

model Role {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name        String           @unique @db.VarChar(64)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(6)
  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  name        String           @unique @db.VarChar(100)
  resource    String           @db.VarChar(64)
  action      String           @db.VarChar(64)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.DateTime(6)
  roles       RolePermission[]

  @@unique([resource, action])
  @@map("permissions")
}

model UserRole {
  userId    BigInt   @map("user_id") @db.UnsignedBigInt
  roleId    BigInt   @map("role_id") @db.UnsignedBigInt
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(6)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       BigInt     @map("role_id") @db.UnsignedBigInt
  permissionId BigInt     @map("permission_id") @db.UnsignedBigInt
  createdAt    DateTime   @default(now()) @map("created_at") @db.DateTime(6)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model EmailOtp {
  id            BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  publicId      String     @unique @map("public_id") @db.Char(36)
  userId        BigInt     @map("user_id") @db.UnsignedBigInt
  otpHash       String     @map("otp_hash") @db.VarChar(255)
  purpose       OtpPurpose
  expiresAt     DateTime   @map("expires_at") @db.DateTime(6)
  verifiedAt    DateTime?  @map("verified_at") @db.DateTime(6)
  invalidatedAt DateTime?  @map("invalidated_at") @db.DateTime(6)
  attempts      Int        @default(0) @db.UnsignedInt
  createdAt     DateTime   @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime   @updatedAt @map("updated_at") @db.DateTime(6)
  user          User       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
  @@map("email_otps")
}

model PasswordResetToken {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(6)
  usedAt    DateTime? @map("used_at") @db.DateTime(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model RefreshToken {
  id        BigInt      @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt      @map("user_id") @db.UnsignedBigInt
  sessionId BigInt      @map("session_id") @db.UnsignedBigInt
  tokenHash String      @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime    @map("expires_at") @db.DateTime(6)
  revokedAt DateTime?   @map("revoked_at") @db.DateTime(6)
  createdAt DateTime    @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime    @updatedAt @map("updated_at") @db.DateTime(6)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  session   UserSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model UserSession {
  id            BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  publicId      String         @unique @map("public_id") @db.Char(36)
  userId        BigInt         @map("user_id") @db.UnsignedBigInt
  deviceId      String?        @map("device_id") @db.VarChar(128)
  deviceName    String?        @map("device_name") @db.VarChar(200)
  ipAddress     String?        @map("ip_address") @db.VarChar(45)
  userAgent     String?        @map("user_agent") @db.VarChar(512)
  lastActiveAt  DateTime       @default(now()) @map("last_active_at") @db.DateTime(6)
  expiresAt     DateTime       @map("expires_at") @db.DateTime(6)
  revokedAt     DateTime?      @map("revoked_at") @db.DateTime(6)
  createdAt     DateTime       @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime       @updatedAt @map("updated_at") @db.DateTime(6)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("user_sessions")
}

model AuditLog {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  userId       BigInt?  @map("user_id") @db.UnsignedBigInt
  action       String   @db.VarChar(100)
  resourceType String?  @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.VarChar(100)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  userAgent    String?  @map("user_agent") @db.VarChar(512)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(6)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id        BigInt    @id @default(autoincrement()) @db.UnsignedBigInt
  userId    BigInt    @map("user_id") @db.UnsignedBigInt
  type      String    @db.VarChar(100)
  title     String    @db.VarChar(255)
  message   String    @db.Text
  data      Json?
  readAt    DateTime? @map("read_at") @db.DateTime(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.DateTime(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model OutboxEvent {
  id            BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  dedupeKey     String?      @unique @map("dedupe_key") @db.VarChar(191)
  eventType     String       @map("event_type") @db.VarChar(100)
  aggregateType String       @map("aggregate_type") @db.VarChar(100)
  aggregateId   String       @map("aggregate_id") @db.VarChar(100)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0) @db.UnsignedInt
  availableAt   DateTime     @default(now()) @map("available_at") @db.DateTime(6)
  processedAt   DateTime?    @map("processed_at") @db.DateTime(6)
  lockedAt      DateTime?    @map("locked_at") @db.DateTime(6)
  lockToken     String?      @map("lock_token") @db.Char(36)
  createdAt     DateTime     @default(now()) @map("created_at") @db.DateTime(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.DateTime(6)

  @@index([status, availableAt])
  @@map("outbox_events")
}
